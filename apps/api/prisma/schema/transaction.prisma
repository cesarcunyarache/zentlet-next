model Category {
  id          String  @id @default(uuid())
  name        String
  icon        String
  color       String
  description String?

  aiSuggestions Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions          Transaction[]
  budgets               Budget[]
  merchantRules         MerchantRule[]
  recurringTransactions RecurringTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("category")
}

model Transaction {
  id String @id @default(uuid())

  type   String
  amount Decimal @db.Decimal(12, 2)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  description String?
  reference   String?

  transactionDate DateTime @db.Date

  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  listId String
  list   TransactionList @relation(fields: [listId], references: [id], onDelete: NoAction)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recurringTransactionId, transactionDate])
  @@index([categoryId])
  @@index([userId, transactionDate(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([listId, transactionDate(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@map("transaction")
}

enum TransactionListRole {
  owner
  editor
  viewer
}

model TransactionList {
  id          String  @id @default(uuid())
  name        String
  icon        String
  color       String
  description String?
  currency    String

  ownerId String
  owner   User   @relation("TransactionListOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  privateOwnerId String? @unique

  archivedAt DateTime?

  members      TransactionListMember[]
  invites      TransactionListInvite[]
  transactions Transaction[]
  budgets      Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("transaction_list")
}

model TransactionListMember {
  listId String
  list   TransactionList @relation(fields: [listId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     TransactionListRole @default(viewer)
  joinedAt DateTime            @default(now())

  @@id([listId, userId])
  @@index([userId])
  @@map("transaction_list_member")
}

model TransactionListInvite {
  id String @id @default(uuid())

  listId String
  list   TransactionList @relation(fields: [listId], references: [id], onDelete: Cascade)

  tokenHash String              @unique
  role      TransactionListRole @default(viewer)
  email     String?
  expiresAt DateTime

  createdById String
  createdBy   User   @relation("TransactionListInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([listId])
  @@map("transaction_list_invite")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

model RecurringTransaction {
  id          String  @id @default(uuid())
  type        String
  amount      Decimal @db.Decimal(12, 2)
  description String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  frequency   RecurrenceFrequency
  anchorDate  DateTime            @db.Date
  nextDueDate DateTime            @db.Date

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextDueDate])
  @@index([userId])
  @@index([categoryId])
  @@map("recurring_transaction")
}
