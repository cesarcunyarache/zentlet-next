model Budget {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  listId String
  list   TransactionList @relation(fields: [listId], references: [id], onDelete: Cascade)

  kind        String   @default("recurring")
  periodUnit  String   @default("month")
  periodCount Int      @default(1)
  startDate   DateTime @db.Date

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  limits BudgetLimit[]
  alerts BudgetAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listId, categoryId])
  @@index([userId])
  @@map("budget")
}

model BudgetAlert {
  id       String  @id @default(uuid())
  budgetId String
  budget   Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  kind     String
  value    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([budgetId, kind, value])
  @@map("budget_alert")
}

model BudgetLimit {
  budgetId      String
  budget        Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @db.Date
  amount        Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([budgetId, effectiveFrom])
  @@map("budget_limit")
}
