generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id
  name          String
  email         String
  emailVerified Boolean @default(false)
  image         String?

  onboardingCompletedAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  sessions              Session[]
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  feedback              Feedback[]
  budgets               Budget[]
  consents              UserConsent[]
  preference            UserPreference?
  subscriptions         Subscription[]
  features              UserFeature[]
  notifications         Notification[]
  emailInbox            EmailInbox?
  gmailConnection       GmailConnection?
  inboxSenders          InboxSender[]
  inboxTransactions     InboxTransaction[]
  merchantRules         MerchantRule[]

  @@unique([email])
  @@map("user")
}

model UserConsent {
  id         String   @id @default(uuid())
  userId     String
  document   String
  version    String
  acceptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, document, version])
  @@index([userId, document, acceptedAt])
  @@map("user_consent")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  language  String   @default("es")
  currency  String   @default("PEN")
  timezone  String   @default("America/Lima")
  extras    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  icon        String
  color       String
  description String?

  aiSuggestions Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions  Transaction[]
  budget        Budget?
  merchantRules MerchantRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("category")
}

model Transaction {
  id String @id @default(uuid())

  type   String
  amount Decimal @db.Decimal(12, 2)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  description String?
  reference   String?

  transactionDate DateTime @db.Date

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([userId, transactionDate(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@map("transaction")
}

model Feedback {
  id      String @id @default(uuid())
  type    String @default("comment")
  status  String @default("open")
  message String @db.VarChar(2000)

  context Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt(sort: Desc)])
  @@map("feedback")
}

model Budget {
  id         String   @id @default(uuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  kind        String   @default("recurring")
  periodUnit  String   @default("month")
  periodCount Int      @default(1)
  startDate   DateTime @db.Date

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  limits BudgetLimit[]
  alerts BudgetAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("budget")
}

model BudgetAlert {
  id       String  @id @default(uuid())
  budgetId String
  budget   Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  kind     String
  value    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([budgetId, kind, value])
  @@map("budget_alert")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  data      Json
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notification")
}

model NotificationDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  status         String       @default("pending")
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  sentAt         DateTime?

  createdAt DateTime @default(now())

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_delivery")
}

model BudgetLimit {
  budgetId      String
  budget        Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @db.Date
  amount        Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([budgetId, effectiveFrom])
  @@map("budget_limit")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model UsageLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())

  @@map("usage_limit")
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String
  planKey          String
  status           String
  amount           Int
  currency         String
  interval         String
  provider         String
  externalId       String?
  checkoutUrl      String?
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments BillingPayment[]

  @@unique([provider, externalId])
  @@index([userId, status])
  @@index([status, updatedAt])
  @@map("subscription")
}

model BillingPayment {
  id                String    @id @default(uuid())
  subscriptionId    String
  provider          String
  externalId        String
  providerPaymentId String?
  status            String
  amount            Int
  refundedAmount    Int       @default(0)
  currency          String
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([subscriptionId, createdAt])
  @@map("billing_payment")
}

model BillingEvent {
  id             String    @id @default(uuid())
  source         String
  type           String
  provider       String?
  externalId     String?
  resourceId     String?
  userId         String?
  subscriptionId String?
  data           Json?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([subscriptionId, createdAt])
  @@index([userId, createdAt])
  @@map("billing_event")
}

enum FeatureType {
  RELEASE
  EXPERIMENT
  OPERATIONAL
  KILL_SWITCH
  PERMISSION
}

model Feature {
  slug        String        @id
  enabled     Boolean       @default(false)
  rollout     Int           @default(100)
  description String?
  type        FeatureType   @default(RELEASE)
  stale       Boolean       @default(false)
  lastUsedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  updatedBy   String?
  users       UserFeature[]

  @@index([enabled])
  @@index([stale])
  @@map("feature")
}

model UserFeature {
  userId     String
  featureId  String
  enabled    Boolean
  assignedAt DateTime @default(now())
  assignedBy String
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [slug], onDelete: Cascade)

  @@id([userId, featureId])
  @@index([featureId])
  @@map("user_feature")
}

model EmailInbox {
  id      String @id @default(uuid())
  address String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verificationCode String?
  verificationUrl  String?
  lastReceivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_inbox")
}

model GmailConnection {
  id    String @id @default(uuid())
  email String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken   String
  status         String    @default("active")
  historyId      BigInt?
  watchExpiresAt DateTime?
  lastSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gmail_connection")
}

model InboxSender {
  id      String @id @default(uuid())
  address String
  status  String
  origin  String

  acceptedCount  Int @default(0)
  dismissedCount Int @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, address])
  @@map("inbox_sender")
}

model InboxTransaction {
  id         String @id @default(uuid())
  status     String @default("pending")
  externalId String

  senderAddress String
  bank          String?
  subject       String
  parser        String
  isVerified    Boolean @default(false)
  isNewSender   Boolean @default(false)

  type            String
  amount          Decimal? @db.Decimal(12, 2)
  currency        String?
  merchant        String?
  description     String
  categoryId      String?
  isLearned       Boolean  @default(false)
  transactionDate DateTime @db.Date
  cardLast4       String?
  reference       String?

  duplicateOfId String?
  transactionId String?   @unique
  resolvedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  receivedAt DateTime
  createdAt  DateTime @default(now())

  @@unique([userId, externalId])
  @@index([userId, status])
  @@map("inbox_transaction")
}

model MerchantRule {
  id          String @id @default(uuid())
  key         String
  description String
  hits        Int    @default(1)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([categoryId])
  @@map("merchant_rule")
}
