model EmailInbox {
  id      String @id @default(uuid())
  address String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verificationCode String?
  verificationUrl  String?
  lastReceivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_inbox")
}

model GmailConnection {
  id    String @id @default(uuid())
  email String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken   String
  status         String    @default("active")
  historyId      BigInt?
  watchExpiresAt DateTime?
  lastSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gmail_connection")
}

model InboxSender {
  id      String @id @default(uuid())
  address String
  status  String
  origin  String

  acceptedCount  Int @default(0)
  dismissedCount Int @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, address])
  @@map("inbox_sender")
}

model InboxTransaction {
  id         String @id @default(uuid())
  status     String @default("pending")
  externalId String

  senderAddress String
  bank          String?
  subject       String
  parser        String
  isVerified    Boolean @default(false)
  isNewSender   Boolean @default(false)

  type            String
  amount          Decimal? @db.Decimal(12, 2)
  currency        String?
  merchant        String?
  description     String
  categoryId      String?
  isLearned       Boolean  @default(false)
  transactionDate DateTime @db.Date
  cardLast4       String?
  reference       String?

  duplicateOfId String?
  transactionId String?   @unique
  resolvedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  receivedAt DateTime
  createdAt  DateTime @default(now())

  @@unique([userId, externalId])
  @@index([userId, status])
  @@map("inbox_transaction")
}

model MerchantRule {
  id          String @id @default(uuid())
  key         String
  description String
  hits        Int    @default(1)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([categoryId])
  @@map("merchant_rule")
}
