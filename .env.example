# database connection string for your local development database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zentlet?schema=public"

#openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key

# Public URL of the site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of your app
BETTER_AUTH_URL=http://localhost:3000 
# Same URL, exposed to the browser (auth client)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# OAuth credentials for Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth credentials for GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Base URL for your API (client-side). Vacío = mismo origen (Next.js).
# Al separar el backend: NEXT_PUBLIC_API_URL=https://api.midominio.com
NEXT_PUBLIC_API_URL=

# Base URL for your API
API_BASE_URL=http://localhost:3000/api

# Gemini API KEY
GOOGLE_GENERATIVE_AI_API_KEY=

# Correo transaccional (verificación y recuperación de contraseña) con Resend.
# Obligatorio en producción: sin él nadie puede verificar su cuenta.
# En desarrollo, sin clave, los correos (con su enlace) se escriben en la terminal.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej. "Zentlet <hola@tudominio.com>"
EMAIL_FROM=

# ── Observabilidad (todo opcional: sin estas variables la app funciona igual) ──
# Detalle en docs/observability.md

# Nivel de logs del servidor: debug | info | warn | error (por defecto debug en dev, info en prod)
LOG_LEVEL=

# Sentry: errores y trazas. El DSN es público por diseño; uno para cada lado.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sólo en el build, para subir source maps. SENTRY_AUTH_TOKEN es SECRETO.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog: product analytics. La clave de proyecto es pública por diseño.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
