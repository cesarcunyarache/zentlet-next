{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "SENTRY_*", "VERCEL_ENV", "NODE_ENV"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {},
    "test:integration": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
